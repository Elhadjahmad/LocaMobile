<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/titre_detail"
        android:textColor="@color/primaire"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Exercice 3, étape 5 : état du chargement ou message d'erreur -->
    <TextView
        android:id="@+id/etat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/chargement"
        android:textColor="@color/erreur"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/carteDetail"
        android:layout_width="match_parent"
        android:visibility="gone"
        android:layout_height="wrap_content"
        android:background="@drawable/fond_carte"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/detailTitre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailVille"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/texte_secondaire" />

        <TextView
            android:id="@+id/detailPrix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/primaire"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailVoyageurs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/detailProprietaire"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/texte_secondaire" />
    </LinearLayout>
</LinearLayout>
