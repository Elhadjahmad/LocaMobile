<?xml version="1.0" encoding="utf-8"?>
<!-- Exercice 2, étape 2 : plus aucune carte écrite à la main. Les cartes sont créées en Java. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/titre_liste"
        android:textColor="@color/primaire"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Exercice 4, étape 4 : qui est connecté + bouton Connexion -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/etatSession"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/texte_secondaire" />

        <Button
            android:id="@+id/boutonConnexion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connexion" />
    </LinearLayout>

    <!-- Exercice 3, étape 7 : barre de recherche par ville -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/champVille"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_ville"
            android:inputType="textCapWords"
            android:maxLines="1" />

        <Button
            android:id="@+id/boutonChercher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/chercher" />
    </LinearLayout>

    <!-- Message d'erreur : caché tant qu'il n'y a pas de problème -->
    <TextView
        android:id="@+id/messageErreur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="@color/erreur"
        android:textSize="16sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Conteneur vide : rempli par afficher() quand la réponse arrive -->
        <LinearLayout
            android:id="@+id/conteneurLogements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
