<?xml version="1.0" encoding="utf-8"?>
<!-- Exercice 1, étape 3 : Android refuse le HTTP non chiffré par défaut.
     On l'autorise SEULEMENT pour 10.0.2.2 (l'ordinateur vu depuis l'émulateur). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
